# MintPRINT Unit0 example
# HOST= below is a placeholder - replace it with your printer's real
# IPv4 address before copying this file to ENV:MintPRINT/Unit0 or
# ENVARC:MintPRINT/Unit0. Left as-is, this configures nothing your
# printer actually uses.
HOST=192.168.1.100
PORT=80
PATH=/ipp/print
ENGINE=jpeg
DEBUG=0
# Capability-backed defaults written by MintPrint Settings after Query Printer.
MEDIA=
SOURCE=
COLOR=
QUALITY=
SCALING=
SIDES=
PWG_SHEET_BACK=normal
